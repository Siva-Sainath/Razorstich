# Local dev — copy to backend/.env
# Mongo is optional for the theater UI; policy + case APIs work without it.

MONGO_URL=
DB_NAME=razorstitch
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional — Smallest AI for phone recovery add-on (not required for core demo)
# Razorpay Test Mode — Standard Checkout (Dashboard → API Keys → Test Mode)
# Required for /pricing sandbox checkout. Use rzp_test_* keys only.
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
